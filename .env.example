# Public URL of the deployed site (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://elitecars-stock.vercel.app

# Admin panel (/admin) — password for logging in. Required to use the admin panel.
ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions (defaults to ADMIN_PASSWORD).
# Changing it logs everyone out.
ADMIN_SESSION_SECRET=

# Vercel Blob — storage for the "Что мы привозим чаще всего" block and its photos.
# Added automatically when you connect a Blob store to the project on Vercel (Storage → Blob).
# Without it (local dev) data is kept in .data/.
BLOB_READ_WRITE_TOKEN=

# Lead form delivery via Telegram bot (optional; leads are logged to console if unset)
# 1. Create a bot with @BotFather and copy the token
# 2. Add the bot to a group/chat and get the chat id (e.g. via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics & webmaster verification (optional)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
